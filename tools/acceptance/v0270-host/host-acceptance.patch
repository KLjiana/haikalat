+package org.hismeo.haikalathost.internal.diagnostics;
+
+import com.kaleblangley.haikalat.backend.GlDebug;
+import com.kaleblangley.haikalat.core.AntiAliasingMode;
+import com.kaleblangley.haikalat.core.presentation.PresentationTarget;
+import com.kaleblangley.haikalat.runtime.RenderSettings;
+import com.kaleblangley.haikalat.runtime.ToneMappingMode;
+import com.kaleblangley.haikalat.subsystems.render3d.*;
+import org.hismeo.haikalathost.HaikalatHost;
+import org.hismeo.haikalathost.api.client.advanced.*;
+import org.joml.Vector3f;
+import org.lwjgl.system.MemoryUtil;
+import org.lwjgl.stb.STBImageWrite;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.ByteBuffer;
+import java.nio.file.*;
+import java.time.Instant;
+import java.util.*;
+import static org.lwjgl.opengl.GL46.*;
+import static org.lwjgl.glfw.GLFW.glfwGetCurrentContext;
+
+/** Opt-in acceptance consumer in an isolated worktree. Never included in ordinary Host activation. */
+public final class V0270VolumetricAcceptance implements HaikalatRenderExtension {
+    private static Object configuredLevel;
+    public static void configureFixture(net.neoforged.neoforge.client.event.ClientTickEvent.Post event) {
+        var client=net.minecraft.client.Minecraft.getInstance();
+        if(client.level==null){configuredLevel=null;return;}
+        if(client.level==configuredLevel||client.player==null||client.getSingleplayerServer()==null)return;
+        configuredLevel=client.level;
+        var id=client.player.getUUID();var server=client.getSingleplayerServer();
+        server.execute(()->{var player=server.getPlayerList().getPlayer(id);if(player!=null){
+            player.setGameMode(net.minecraft.world.level.GameType.SPECTATOR);player.setInvulnerable(true);
+            HaikalatHost.LOGGER.info("V0270_HOST fixture spectator camera; survival hurt/bobbing projection is outside this test");
+        }});
+    }
+    private final Path directory=Path.of(System.getProperty("haikalathost.v0270Evidence"));
+    private final Set<Long> owned=new HashSet<>();
+    private GlDebug.ResourceTrackingLease tracking;
+    private RenderPipeline pipeline;
+    private long ownerThread, nativeContext, sequence, pollAt, frames, world;
+    private boolean released;
+    private String capture;
+    private long observedTarget=-1;
+
+    @Override public void initialize(HaikalatEngineContext context) {
+        ownerThread=Thread.currentThread().threadId();nativeContext=glfwGetCurrentContext();
+        tracking=GlDebug.acquireResourceTracking();
+        try {Files.createDirectories(directory);Files.writeString(directory.resolve("events.csv"),
+                "utc,event,command,world,frame,thread,context,target,width,height,targetGeneration,fog,graphRevision,ownedLive,estimatedBytes,detail\n");}
+        catch(IOException failure){throw new UncheckedIOException(failure);}
+        event("initialize",null,"engine="+getClass().getProtectionDomain().getCodeSource()+" gl="+GlDebug.contextInfo());
+    }
+
+    @Override public void render(HaikalatFrameContext frame) {
+        requireOwner();frames++;
+        Set<Long> before=live();
+        try {
+            if(pipeline==null&&!released) {create(frame);world++;event("world-first-frame",frame,"");}
+            if(frame.target().generation()!=observedTarget) {
+                observedTarget=frame.target().generation();event("target-change",frame,"");
+            }
+            poll(frame);
+            if(pipeline!=null) pipeline.render(frame.device(),frame.camera(),frame.target(),frame.deltaSeconds());
+            validateBorrowed(frame.target());
+            GlDebug.assertNoError("v0270 real Minecraft consumer");
+            account(before);
+            if(capture!=null) {
+                capture(frame.target(),capture);event("captured",frame,capture);capture=null;
+            }
+        } catch(RuntimeException|Error failure) {account(before);event("FAIL",frame,failure.toString());throw failure;}
+    }
+
+    private void create(HaikalatFrameContext frame) {
+        var scene=new Scene(new Camera());
+        scene.addLight(SceneLight.directional(new Vector3f(0,-1,-1),new Vector3f(.6f,.8f,1),2));
+        pipeline=new RenderPipeline(frame.target(),scene,null,RenderSettings.builder()
+                .antiAliasingMode(AntiAliasingMode.NONE).toneMappingMode(ToneMappingMode.ACES).vsync(false).build());
+        pipeline.build();
+    }
+
+    private VolumetricFogSettings fog(float density,VolumetricFogSettings.Quality quality) {
+        return new VolumetricFogSettings(true,32,quality,
+                FogMediumSettings.homogeneous(density,new Vector3f(.7f),new Vector3f(.002f,.004f,.01f)),
+                List.of(),0,false,.9f,242,new Vector3f());
+    }
+
+    private void poll(HaikalatFrameContext frame) {
+        long now=System.nanoTime();if(now<pollAt)return;pollAt=now+200_000_000L;
+        Path command=directory.resolve("control.txt");if(!Files.isRegularFile(command))return;
+        String text;
+        try{text=Files.readString(command).strip();}catch(IOException failure){throw new UncheckedIOException(failure);}
+        if(text.isEmpty())return;
+        String[] parts=text.split("\\s+",2);long next=Long.parseLong(parts[0]);if(next<=sequence)return;
+        sequence=next;String operation=parts[1];
+        if(pipeline==null&&!operation.equals("RELEASE")&&!operation.equals("STOP")) {released=false;create(frame);world++;}
+        switch(operation) {
+            case "ENABLE" -> pipeline.applyVolumetricFog(fog(.015f,VolumetricFogSettings.Quality.BALANCED));
+            case "DENSITY" -> {
+                var graph=pipeline.graph();long revision=graph.description().topologyRevision();
+                pipeline.applyVolumetricFog(fog(.08f,pipeline.volumetricFog().quality()));
+                if(pipeline.graph()!=graph||graph.description().topologyRevision()!=revision)
+                    throw new IllegalStateException("scalar density rebuilt the real host graph");
+            }
+            case "QUALITY" -> pipeline.applyVolumetricFog(fog(.08f,VolumetricFogSettings.Quality.HIGH));
+            case "DISABLE" -> pipeline.applyVolumetricFog(VolumetricFogSettings.disabled());
+            case "FAIL_PREPARE" -> {
+                var graph=pipeline.graph();var old=pipeline.volumetricFog();
+                System.setProperty("haikalat.test.failVolumeGraph","true");boolean failed=false;
+                try{pipeline.applyVolumetricFog(fog(.04f,old.quality()==VolumetricFogSettings.Quality.HIGH
+                        ?VolumetricFogSettings.Quality.BALANCED:VolumetricFogSettings.Quality.HIGH));}
+                catch(RuntimeException expected){failed=true;event("expected-candidate-failure",frame,expected.toString());}
+                finally{System.clearProperty("haikalat.test.failVolumeGraph");}
+                if(!failed||pipeline.graph()!=graph||!pipeline.volumetricFog().equals(old))throw new IllegalStateException("candidate rollback violated");
+            }
+            case "FAIL_RELOAD" -> {
+                var graph=pipeline.graph();boolean failed=false;
+                System.setProperty("haikalat.test.failVolumeCompilation","0");
+                try{pipeline.build();}catch(RuntimeException expected){failed=true;event("expected-rebuild-failure",frame,expected.toString());}
+                finally{System.clearProperty("haikalat.test.failVolumeCompilation");}
+                if(!failed||pipeline.graph()!=graph)throw new IllegalStateException("reload rollback violated");
+            }
+            case "REBUILD" -> pipeline.build();
+            case "MC_RELOAD" -> net.minecraft.client.Minecraft.getInstance().tell(() ->
+                    net.minecraft.client.Minecraft.getInstance().reloadResourcePacks());
+            case "RESIZE" -> {
+                org.lwjgl.glfw.GLFW.glfwRestoreWindow(nativeContext);
+                int width=frame.target().width()==961?1281:961;
+                org.lwjgl.glfw.GLFW.glfwSetWindowSize(nativeContext,width,width==961?541:721);
+            }
+            case "SWITCH_WORLD" -> net.minecraft.client.Minecraft.getInstance().tell(() -> {
+                var minecraft=net.minecraft.client.Minecraft.getInstance();
+                minecraft.level.disconnect();
+                minecraft.disconnect();
+                new net.minecraft.client.gui.screens.worldselection.WorldOpenFlows(minecraft,minecraft.getLevelSource())
+                        .openWorld("V0270Acceptance2",()->{throw new IllegalStateException("acceptance world switch failed");});
+            });
+            case "STOP" -> net.minecraft.client.Minecraft.getInstance().tell(net.minecraft.client.Minecraft.getInstance()::stop);
+            case "RELEASE" -> {release();released=true;validateBorrowed(frame.target());}
+            case "CAPTURE" -> { }
+            default -> throw new IllegalArgumentException("unknown acceptance command "+operation);
+        }
+        capture=String.format(Locale.ROOT,"world-%02d-command-%03d-%s",world,sequence,operation);
+        event("operation",frame,operation);
+    }
+
+    @Override public void resourcesReloaded(HaikalatReloadContext context) {
+        requireOwner();Set<Long> before=live();
+        try {if(pipeline!=null)pipeline.build();event("minecraft-resource-reload",null,"resourceGeneration="+context.resourceGeneration());}
+        finally{account(before);}
+    }
+    @Override public void worldClosed(HaikalatEngineContext context) {
+        requireOwner();release();released=false;event("minecraft-world-closed",null,"");
+    }
+    @Override public void close(HaikalatEngineContext context) {
+        requireOwner();release();event("minecraft-shutdown",null,"");tracking.close();
+    }
+    private void release() {
+        if(pipeline!=null){pipeline.close();pipeline=null;}
+        long outstanding=live().stream().filter(owned::contains).count();
+        if(outstanding!=0)throw new IllegalStateException("acceptance consumer leaked "+outstanding+" tracked objects");
+    }
+    private void requireOwner() {
+        if(Thread.currentThread().threadId()!=ownerThread||glfwGetCurrentContext()!=nativeContext)
+            throw new IllegalStateException("wrong actual Minecraft owner/context");
+    }
+    private Set<Long> live() {
+        Set<Long> result=new HashSet<>();for(var r:GlDebug.resources().liveResources())result.add(r.resourceSequence());return result;
+    }
+    private void account(Set<Long> before) {for(long id:live())if(!before.contains(id))owned.add(id);}
+    private void validateBorrowed(PresentationTarget target) {
+        if(!glIsFramebuffer(target.drawFramebufferId()))throw new IllegalStateException("Minecraft framebuffer was destroyed");
+        for(var attachment:List.of(target.color(),target.depth()))if(attachment.isPresent()&&!glIsTexture(attachment.orElseThrow().textureId()))
+            throw new IllegalStateException("Minecraft borrowed attachment was destroyed");
+    }
+    private void event(String kind,HaikalatFrameContext frame,String detail) {
+        if(pipeline!=null)detail+=" allocation="+pipeline.volumetricAllocationDiagnostics();
+        var target=frame==null?null:frame.target();var resources=GlDebug.resources();
+        long ownLive=resources.liveResources().stream().filter(r->owned.contains(r.resourceSequence())).count();
+        String row=Instant.now()+","+kind+","+sequence+","+world+","+frames+","+Thread.currentThread().threadId()+","+glfwGetCurrentContext()+","+
+                (target==null?-1:target.drawFramebufferId())+","+(target==null?0:target.width())+","+(target==null?0:target.height())+","+
+                (target==null?-1:target.generation())+","+(pipeline!=null&&pipeline.volumetricFog().enabled())+","+
+                (pipeline==null?-1:pipeline.graph().description().topologyRevision())+","+ownLive+","+resources.estimatedBytes()+","+detail.replace(',',';').replace('\n',' ')+"\n";
+        try{Files.writeString(directory.resolve("events.csv"),row,StandardOpenOption.APPEND);}catch(IOException failure){throw new UncheckedIOException(failure);}
+        HaikalatHost.LOGGER.info("V0270_HOST {} command={} world={} {}",kind,sequence,world,detail);
+    }
+    private void capture(PresentationTarget target,String name) {
+        int width=target.width(),height=target.height();ByteBuffer pixels=MemoryUtil.memAlloc(Math.multiplyExact(width*height,4));
+        ByteBuffer flipped=MemoryUtil.memAlloc(pixels.capacity());
+        try {
+            glBindFramebuffer(GL_READ_FRAMEBUFFER,target.readFramebufferId());glReadBuffer(GL_COLOR_ATTACHMENT0);
+            glBindBuffer(GL_PIXEL_PACK_BUFFER,0);glPixelStorei(GL_PACK_ALIGNMENT,1);
+            glReadPixels(0,0,width,height,GL_RGBA,GL_UNSIGNED_BYTE,pixels);
+            int stride=width*4;for(int y=height-1;y>=0;y--)flipped.put(pixels.slice(y*stride,stride));flipped.flip();
+            if(!STBImageWrite.stbi_write_png(directory.resolve(name+".png").toString(),width,height,4,flipped,stride))
+                throw new IllegalStateException("host PNG capture failed");
+        }finally{MemoryUtil.memFree(flipped);MemoryUtil.memFree(pixels);}
+    }
+}
