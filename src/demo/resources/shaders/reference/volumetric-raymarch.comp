    // The replicated production query is transport/probe diagnostics only.
    referencePixels[count+index]=candidate;referencePixels[2*count+index]=base;
    referencePixels[uReferenceCountPlane*count+index]=vec4(float(evaluations),truncated?1.0:0.0,endpoint,deviceDepth);
    // This optional probe does not feed the independent image reference or its acceptance metrics.
    if(nativePixel==ivec2(uReferenceProbeX,uReferenceProbeY)) {
        vec3 endView=vCounts.z!=0 ? projectionPoint*(endpoint/-projectionPoint.z) : vec3(projectionPoint.xy,-endpoint);
        referencePixels[uReferenceProbeBase]=(vInverseView*vec4(endView,1));
        referencePixels[uReferenceProbeBase].w=endpoint;
        referencePixels[uReferenceProbeBase+1]=candidate;
        referencePixels[uReferenceProbeBase+2]=transport;
        vec2 coordinate=vec2(volumeColumnCoordinate(pixel.x,vGrid.x,int(vExtentDepth.x)),
                volumeColumnCoordinate(pixel.y,vGrid.y,int(vExtentDepth.y)));
        ivec2 low=ivec2(floor(coordinate)),high=min(low+1,vGrid.xy-1);vec2 f=fract(coordinate);
        vec4 fine[4];
        for(int i=0;i<4;i++) {
            ivec2 column=ivec2((i&1)==0?low.x:high.x,i<2?low.y:high.y);
            vec2 columnPixel=volumePixel(column),columnNdc=2.0*columnPixel/vExtentDepth.xy-1;
            vec4 columnClip=vInverseProjection*vec4(columnNdc,-1,1);
            int countEvaluations;bool capped;
            fine[i]=referenceTransport(columnClip.xyz/columnClip.w,endpoint,countEvaluations,capped);
            referencePixels[uReferenceProbeBase+4+i]=fine[i];
