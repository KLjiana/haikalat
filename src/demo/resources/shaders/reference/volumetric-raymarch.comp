            float guideRaw=texelFetch(uReferenceOpaqueDepth,guidePixel,0).r;
            vec4 guideClip=vInverseProjection*vec4(2.0*(vec2(guidePixel)+0.5)/vExtentDepth.xy-1,2.0*guideRaw-1,1);
            float guideDepth=guideRaw>=1 ? vExtentDepth.w : -guideClip.z/guideClip.w;
            referencePixels[uReferenceProbeBase+8+i]=vec4(columnPixel,guideDepth,guideRaw);
            referencePixels[uReferenceProbeBase+12+i]=volumeQueryColumn(column,endpoint);
            int interval=volumeInterval(endpoint);float start=volumeBoundary(interval);
            vec4 finePrefix=referenceTransport(columnClip.xyz/columnClip.w,start,countEvaluations,capped);
            referencePixels[uReferenceProbeBase+16+i]=texelFetch(uVolumePrefix,ivec3(column,interval),0);
            referencePixels[uReferenceProbeBase+20+i]=finePrefix;
            referencePixels[uReferenceProbeBase+24+i]=finePrefix.a>1e-8
                ? vec4((fine[i].rgb-finePrefix.rgb)/finePrefix.a,fine[i].a/finePrefix.a) : vec4(-1.0);
