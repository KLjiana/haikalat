    vec4 endpointClip=vInverseProjection*vec4(ndc,2.0*deviceDepth-1.0,1);
    float endpoint=deviceDepth>=1.0 ? vExtentDepth.w : clamp(-endpointClip.z/endpointClip.w,0.0,vExtentDepth.w);
    int evaluations;bool truncated;
    vec4 base=texelFetch(uReferenceOpaqueColor,nativePixel,0),transport=referenceTransport(projectionPoint,endpoint,evaluations,truncated);
    int count=uReferenceWidth*uReferenceHeight,index=p.x+p.y*uReferenceWidth;
    referencePixels[uReferencePlane*count+index]=vec4(transport.rgb+transport.a*base.rgb,1);
    referencePixels[(uReferencePlane+1)*count+index]=transport;
    vec4 candidate=volumeRefineNativeRay(pixel,endpoint,volumeQuery(pixel,endpoint));
