void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);if(p.x>=uReferenceWidth||p.y>=uReferenceRows)return;p.y+=uReferenceRow;
    ivec2 nativePixel=min(p*uReferenceStride+uReferenceStride/2,ivec2(vExtentDepth.xy)-1);
    vec2 pixel=vec2(nativePixel)+0.5,ndc=2.0*pixel/vExtentDepth.xy-1.0;
    vec4 nearClip=vInverseProjection*vec4(ndc,-1,1);vec3 projectionPoint=nearClip.xyz/nearClip.w;
