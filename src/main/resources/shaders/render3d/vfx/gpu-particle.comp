#version 460 core

layout (local_size_x = 64) in;

struct Particle {
    vec4 positionLife;
    vec4 velocitySeed;
};

layout (std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

uniform float uDeltaSeconds;
uniform float uTimeSeconds;
uniform int uParticleCount;

uint hash(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    return value ^ (value >> 16);
}

float random01(inout uint state) {
    state = hash(state);
    return float(state) / 4294967295.0;
}

void respawn(uint index, inout Particle particle) {
    uint cycle = uint(floor(uTimeSeconds * 60.0));
    uint state = hash(index * 747796405u + cycle * 2891336453u + 277803737u);
    float angle = random01(state) * 6.28318530718;
    float radius = sqrt(random01(state)) * 0.55;
    float heightJitter = random01(state);
    float speed = mix(0.55, 1.25, random01(state));
    particle.positionLife = vec4(cos(angle) * radius, -0.72,
            sin(angle) * radius * 0.35, mix(1.2, 2.4, heightJitter));
    particle.velocitySeed = vec4(cos(angle) * 0.13, speed,
            sin(angle) * 0.08, random01(state));
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(uParticleCount)) return;
    Particle particle = particles[index];
    if (particle.positionLife.w <= 0.0) {
        respawn(index, particle);
    } else {
        particle.velocitySeed.y -= 0.38 * uDeltaSeconds;
        particle.positionLife.xyz += particle.velocitySeed.xyz * uDeltaSeconds;
        particle.positionLife.w -= uDeltaSeconds;
        if (particle.positionLife.w <= 0.0) respawn(index, particle);
    }
    particles[index] = particle;
}
