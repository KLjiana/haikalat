#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D uEquirectangular;
layout(rgba16f, binding = 0) writeonly uniform imageCube uOutput;

const float PI = 3.14159265358979323846;

vec3 faceDirection(uint face, vec2 p) {
    if (face == 0u) return normalize(vec3( 1.0, -p.y, -p.x));
    if (face == 1u) return normalize(vec3(-1.0, -p.y,  p.x));
    if (face == 2u) return normalize(vec3( p.x,  1.0,  p.y));
    if (face == 3u) return normalize(vec3( p.x, -1.0, -p.y));
    if (face == 4u) return normalize(vec3( p.x, -p.y,  1.0));
    return normalize(vec3(-p.x, -p.y, -1.0));
}

void main() {
    ivec2 size = imageSize(uOutput);
    ivec3 pixel = ivec3(gl_GlobalInvocationID);
    if (pixel.x >= size.x || pixel.y >= size.y || pixel.z >= 6) return;
    vec2 p = (vec2(pixel.xy) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec3 direction = faceDirection(uint(pixel.z), p);
    vec2 uv = vec2(atan(direction.z, direction.x) / (2.0 * PI) + 0.5,
                   asin(clamp(direction.y, -1.0, 1.0)) / PI + 0.5);
    imageStore(uOutput, pixel, vec4(textureLod(uEquirectangular, uv, 0.0).rgb, 1.0));
}
