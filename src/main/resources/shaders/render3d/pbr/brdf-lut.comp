#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rg16f, binding = 0) writeonly uniform image2D uOutput;
uniform int uSampleCount;

const float PI = 3.14159265358979323846;

float radicalInverse(uint bits) {
    bits = bitfieldReverse(bits);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 hammersley(uint i, uint count) {
    return vec2(float(i) / float(count), radicalInverse(i));
}

vec3 importanceSampleGgx(vec2 xi, float roughness) {
    float a = max(roughness * roughness, 0.001);
    float phi = 2.0 * PI * xi.x;
    float cosTheta = sqrt((1.0 - xi.y) / (1.0 + (a * a - 1.0) * xi.y));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    return vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
}

float geometrySchlickGgx(float nDotV, float roughness) {
    float k = roughness * roughness * 0.5;
    return nDotV / max(nDotV * (1.0 - k) + k, 1.0e-5);
}

void main() {
    ivec2 size = imageSize(uOutput);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float nDotV = clamp(uv.x, 1.0e-4, 1.0);
    float roughness = clamp(uv.y, 0.0, 1.0);
    vec3 v = vec3(sqrt(max(0.0, 1.0 - nDotV * nDotV)), 0.0, nDotV);
    float a = 0.0;
    float b = 0.0;
    uint count = uint(max(uSampleCount, 1));
    for (uint i = 0u; i < count; ++i) {
        vec3 h = importanceSampleGgx(hammersley(i, count), roughness);
        vec3 l = normalize(2.0 * dot(v, h) * h - v);
        float nDotL = max(l.z, 0.0);
        float nDotH = max(h.z, 0.0);
        float vDotH = max(dot(v, h), 0.0);
        if (nDotL > 0.0) {
            float g = geometrySchlickGgx(nDotV, roughness)
                    * geometrySchlickGgx(nDotL, roughness);
            float gVisibility = g * vDotH / max(nDotH * nDotV, 1.0e-5);
            float fc = pow(1.0 - vDotH, 5.0);
            a += (1.0 - fc) * gVisibility;
            b += fc * gVisibility;
        }
    }
    imageStore(uOutput, pixel, vec4(a / float(count), b / float(count), 0.0, 1.0));
}
