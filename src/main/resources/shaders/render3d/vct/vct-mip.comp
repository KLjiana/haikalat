#version 460 core

// Compute downsample between two adjacent levels of the voxel mip chain.
//
// Radiance is weighted by coverage, while the destination coverage is the
// maximum of the eight source texels. Maximum coverage is deliberately
// conservative: it keeps a one-voxel shell visible at coarse levels instead of
// averaging it into transparency, which is the primary thin-wall leak control.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(rgba16f, binding = 0) readonly uniform image3D uSource;
layout(rgba16f, binding = 1) writeonly uniform image3D uDestination;

uniform vec3 uRegionMin;
uniform vec3 uRegionSize;
uniform vec3 uSourceSize;

void main() {
    ivec3 regionMinimum = ivec3(uRegionMin);
    ivec3 regionSize = ivec3(uRegionSize);
    ivec3 sourceSize = ivec3(uSourceSize);
    ivec3 local = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(local, regionSize))) return;
    ivec3 destination = regionMinimum + local;
    ivec3 sourceBase = destination * 2;
    vec3 weightedRadiance = vec3(0.0);
    float coverage = 0.0;
    float weight = 0.0;
    for (int z = 0; z < 2; ++z) {
        for (int y = 0; y < 2; ++y) {
            for (int x = 0; x < 2; ++x) {
                ivec3 source = min(sourceBase + ivec3(x, y, z), sourceSize - ivec3(1));
                vec4 value = imageLoad(uSource, source);
                weightedRadiance += value.rgb * value.a;
                coverage = max(coverage, value.a);
                weight += value.a;
            }
        }
    }
    vec3 radiance = weight > 1e-6 ? weightedRadiance / weight : vec3(0.0);
    imageStore(uDestination, destination, vec4(radiance, coverage));
}
