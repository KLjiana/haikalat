#version 460 core

uniform mat4 uProjView;
uniform vec4 uGrid; // center x/y, spacing, local scale
uniform vec2 uTimeRotation; // cosine and sine of the shared time angle
uniform int uColumnShift;
uniform int uColumnMask;

out vec3 vColor;

const vec3 PRIMITIVE_VERTICES[@VERTEX_COUNT@] = vec3[@VERTEX_COUNT@](
@POSITIONS@
);

const vec2 ROTATION_LUT[16] = vec2[16](
    vec2(1.000000000, 0.000000000), vec2(0.923879533, 0.382683432),
    vec2(0.707106781, 0.707106781), vec2(0.382683432, 0.923879533),
    vec2(0.000000000, 1.000000000), vec2(-0.382683432, 0.923879533),
    vec2(-0.707106781, 0.707106781), vec2(-0.923879533, 0.382683432),
    vec2(-1.000000000, 0.000000000), vec2(-0.923879533, -0.382683432),
    vec2(-0.707106781, -0.707106781), vec2(-0.382683432, -0.923879533),
    vec2(0.000000000, -1.000000000), vec2(0.382683432, -0.923879533),
    vec2(0.707106781, -0.707106781), vec2(0.923879533, -0.382683432)
);

void main() {
    int instance = gl_InstanceID;
    int column = instance & uColumnMask;
    int row = instance >> uColumnShift;
    vec2 translation = (vec2(column, row) - uGrid.xy) * uGrid.z;

    vec2 baseRotation = ROTATION_LUT[instance & 15];
    float c = baseRotation.x * uTimeRotation.x - baseRotation.y * uTimeRotation.y;
    float s = baseRotation.y * uTimeRotation.x + baseRotation.x * uTimeRotation.y;
    vec3 local = PRIMITIVE_VERTICES[gl_VertexID] * uGrid.w;
@ROTATE_LOCAL@

    uint hash = uint(instance) * 1664525u + 1013904223u;
    vColor = vec3(0.25) + unpackUnorm4x8(hash).rgb * 0.75;
    gl_Position = uProjView * vec4(local + vec3(translation, @DEPTH@), 1.0);
}
